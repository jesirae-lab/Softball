# Copy this file to .env.local and fill in your SMTP credentials
# Without these, emails will be logged to the console in preview mode

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Softball League <your-email@gmail.com>"
LEAGUE_ADMIN_EMAIL=admin@softballleague.com
